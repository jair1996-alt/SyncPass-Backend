# Variables de entorno para desarrollo local
# Copia este archivo a .env y ajusta los valores

# Base de datos
DATABASE_URL=jdbc:postgresql://localhost:5432/cursos_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# AWS Cognito
AWS_REGION=us-east-1
AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
AWS_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_COGNITO_CLIENT_SECRET=
# IDs de App Clients adicionales permitidos para validar access tokens (Android, React, etc.)
# Separados por coma. El valor de AWS_COGNITO_CLIENT_ID siempre se agrega automáticamente.
AWS_COGNITO_ALLOWED_CLIENT_IDS=
# Issuer del User Pool (obligatorio para validar JWT)
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx

# CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=3600

# App
SERVER_PORT=8080
LOG_LEVEL=DEBUG